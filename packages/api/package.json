{
  "name": "@blog/api",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "postinstall": "node scripts/ensure-prisma.mjs",
    "prisma:generate": "node scripts/ensure-prisma.mjs",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema src/db/prisma/schema.prisma",
    "prisma:deploy": "dotenv -e ../../.env -- prisma migrate deploy --schema src/db/prisma/schema.prisma",
    "prisma:generate:force": "prisma generate --schema src/db/prisma/schema.prisma",
    "check:ai": "tsx src/check-ai.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@kenjiuno/msgreader": "^1.28.0",
    "@prisma/client": "^5.22.0",
    "fastify": "^5.12.5",
    "mailparser": "^3.7.0",
    "mammoth": "^1.8.0",
    "prisma": "^5.22.0",
    "sanitize-html": "^2.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.5",
    "@types/node": "^20.14.0",
    "@types/sanitize-html": "^2.13.0",
    "cfb": "^1.2.2",
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  }
}
