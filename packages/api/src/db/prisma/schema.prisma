generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Eine Ziel-Website (WordPress) mit ihrem Stilprofil.
model Site {
  id         String   @id @default(cuid())
  name       String
  baseUrl    String   @default("")
  language   String   @default("de")
  // Zielgruppe, Tonalitaet und freier Stilleitfaden gehen 1:1 in die Prompts ein.
  audience   String   @default("")
  tone       String   @default("")
  styleGuide String   @default("")
  // Wird (nicht durch die KI, sondern im Code) unter jeden Beitrag gesetzt.
  disclaimer String   @default("")
  // WordPress-Zugang (REST-API mit Anwendungspasswort). Das Passwort liegt nur verschluesselt in der DB.
  // KI-generierte Bilder in der Bildunterschrift kennzeichnen ("Bild: KI-generiert")
  labelAiImages Boolean @default(true)
  wpUsername    String @default("")
  wpAppPassword String @default("")
  createdAt  DateTime @default(now())

  submissions Submission[]
  posts       Post[]
  styleSamples StyleSample[]
}

// Beispielbeitrag einer Website als Stilvorlage (importiert aus WordPress oder eingefuegt).
model StyleSample {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  title     String
  url       String   @default("")
  text      String
  createdAt DateTime @default(now())
}

enum SubmissionStatus {
  UPLOADED
  ANALYZING
  ANALYZED
  FAILED
}

// Ein Upload-Vorgang: eine oder mehrere Dateien zu einem Thema fuer eine Website.
model Submission {
  id        String           @id @default(cuid())
  siteId    String
  site      Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  note      String           @default("")
  status    SubmissionStatus @default(UPLOADED)
  error     String?
  createdAt DateTime         @default(now())

  documents Document[]
  topics    Topic[]
}

model Document {
  id            String     @id @default(cuid())
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  filename      String
  mimeType      String
  sizeBytes     Int
  storageKey    String
  // Ausgelesener Text (Mails, Word, Text). Bei PDFs/Bildern leer - die gehen direkt an Claude.
  extractedText String?
  createdAt     DateTime   @default(now())
}

// Von der KI vorgeschlagenes Beitragsthema.
model Topic {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  title        String
  angle        String
  summary      String
  keyFacts     Json       @default("[]")
  keywords     Json       @default("[]")
  createdAt    DateTime   @default(now())

  posts Post[]
}

enum ImageStatus {
  PLANNED
  QUEUED
  GENERATING
  READY
  FAILED
}

enum ImageOrigin {
  AI
  UPLOAD
}

// Beitragsbild (genau eines je Beitrag): geplant (Prompt/Alt-Text), KI-generiert oder hochgeladen.
model PostImage {
  id          String      @id @default(cuid())
  postId      String      @unique
  post        Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  status      ImageStatus @default(PLANNED)
  origin      ImageOrigin @default(AI)
  // Bei Uploads vom Nutzer angegeben (z. B. Bild aus einem KI-Dienst); bei origin AI immer true. Steuert Kennzeichnung und Metadaten.
  aiGenerated Boolean     @default(true)
  error       String?
  style       String      @default("illustration")
  prompt      String      @default("")
  altText     String      @default("")
  caption     String      @default("")
  searchQuery String      @default("")
  // Quelle/Lizenz bei hochgeladenen Bildern (z. B. "Pexels, Pexels-Lizenz, Foto: Name")
  sourceNote  String      @default("")
  storageKey  String?
  mimeType    String?
  // Verknuepfung mit der WordPress-Mediathek; wird bei jeder Aenderung am Bild zurueckgesetzt
  wpMediaId   Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum PostStatus {
  QUEUED
  RESEARCHING
  DRAFTING
  FACTCHECKING
  DRAFT_READY
  FAILED
}

model Post {
  id                String     @id @default(cuid())
  siteId            String
  site              Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  topicId           String
  topic             Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  status            PostStatus @default(QUEUED)
  error             String?
  title             String?
  slug              String?
  metaDescription   String?
  focusKeyword      String?
  secondaryKeywords Json       @default("[]")
  excerpt           String?
  contentHtml       String?
  // [{ title, url, note }] - nur Quellen, die Claude tatsaechlich gefunden/verwendet hat.
  sources           Json       @default("[]")
  // Aussagen im Text, fuer die keine Quelle gefunden wurde -> manuell pruefen.
  unverifiedClaims  Json       @default("[]")
  // Ergebnis des Faktencheck-Durchlaufs: { status, summary, issues[], references[], ranAt } oder { status: "skipped", error }
  factCheck         Json?
  researchNotes     String?
  // Bei Ueberarbeitungen: { wpPostId, title, url, html, instructions } des bestehenden Beitrags. Das Original wird nie veraendert.
  revisionSource    Json?
  // Verknuepfung mit dem Entwurf in WordPress (nach "An WordPress senden")
  wpPostId          Int?
  wpEditUrl         String?
  wpLink            String?
  wpCategoryIds     Json       @default("[]")
  wpSeo             Json?
  wpPushedAt        DateTime?
  image             PostImage?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}
