# --- Datenbank ---
DATABASE_URL=postgresql://blog:blog@localhost:5433/blog_assistent

# --- Login (nur ein Benutzer) ---
# Passwort fuer die Weboberflaeche und Secret zum Signieren des Session-Cookies (min. 32 Zeichen)
ADMIN_PASSWORD=bitte-aendern
SESSION_SECRET=bitte-durch-langen-zufallswert-ersetzen-min-32-zeichen

# --- KI ---
# "claude" = echte Claude-API, "fake" = Platzhalter-Antworten ohne API-Key (nur zum Ausprobieren der Oberflaeche)
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
# Nur ausfuellen, wenn die API meldet "API key is not scoped to a workspace": ID des Workspaces aus der Anthropic Console
ANTHROPIC_WORKSPACE_ID=
# Normalerweise nicht aendern. Bewusst nicht ANTHROPIC_BASE_URL, damit zufaellige Systemvariablen nichts umleiten.
AI_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=medium
# Maximale Anzahl Web-Suchen pro Recherche
RESEARCH_MAX_SEARCHES=8

# --- Bildgenerierung (optional) ---
# none        = nur Bild-Prompts, Stockfoto-Links und Upload (kein Zusatzdienst noetig)
# supermachine = Bilder ueber die Supermachine-API erzeugen (Key aus dem Profil bei supermachine.art, beginnt mit sk-)
# openai      = Bilder ueber OpenAI erzeugen (eigener Account/Key noetig)
IMAGE_PROVIDER=none
IMAGE_API_KEY=
# Leer lassen = Standard des Anbieters (supermachine: "Supermachine NextGen", openai: "gpt-image-1")
IMAGE_MODEL=
# Nur Supermachine: Bildgroesse in Pixeln (Standard 1024x768)
IMAGE_WIDTH=
IMAGE_HEIGHT=
# Sprache der Bild-Prompts: de (Standard) oder en. Liefert ein Bildmodell mit Deutsch schwache Ergebnisse (z. B. manche Modelle bei Supermachine), hier en setzen.
IMAGE_PROMPT_LANGUAGE=de
# Nur OpenAI: low | medium | high (hoehere Qualitaet kostet mehr)
IMAGE_QUALITY=medium

# --- Dateiablage fuer Uploads ---
STORAGE_DIR=./data/uploads

# --- Server ---
PORT=3100
HOST=0.0.0.0

# Optional: Zielordner fuer Sicherungen (backup.cmd). Ohne Angabe: .\backups im Projektordner.
# Besser ein Ordner, der ohnehin gesichert wird (z. B. OneDrive):
# BACKUP_DIR=C:\Users\IHRNAME\OneDrive\Blog-Assistent-Backup

# Preise fuer die Kostenuebersicht (USD, nur Schaetzung - bitte mit der aktuellen Preisliste des KI-Anbieters abgleichen)
AI_PRICE_INPUT_PER_MTOK=5
AI_PRICE_OUTPUT_PER_MTOK=25
AI_PRICE_SEARCH_PER_1000=10
# Kosten je erzeugtem Bild in USD (z. B. 0.04); 0 = Bildkosten nicht mitrechnen
IMAGE_COST_USD=0
