# --- Datenbank ---
DATABASE_URL=postgresql://blog:blog@localhost:5433/blog_assistent

# --- Login (nur ein Benutzer) ---
# Passwort fuer die Weboberflaeche und Secret zum Signieren des Session-Cookies (min. 32 Zeichen)
ADMIN_PASSWORD=bitte-aendern
SESSION_SECRET=bitte-durch-langen-zufallswert-ersetzen-min-32-zeichen

# --- KI ---
# "claude" = echte Claude-API, "fake" = Platzhalter-Antworten ohne API-Key (nur zum Ausprobieren der Oberflaeche)
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=medium
# Maximale Anzahl Web-Suchen pro Recherche
RESEARCH_MAX_SEARCHES=8

# --- Dateiablage fuer Uploads ---
STORAGE_DIR=./data/uploads

# --- Server ---
PORT=3100
HOST=0.0.0.0
